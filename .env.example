PORT=3000

# Solo en 1 cuando la app corre detrás de un reverse proxy real (nginx en
# producción, ver deploy/nginx.conf.example). Deja esto vacío/en 0 en
# desarrollo local — ver el comentario junto a app.set('trust proxy', ...)
# en src/server.js para por qué importa.
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mpv_dental

# Opcionales — ver src/config/db.js. Los defaults (10 conexiones, 5s para
# conseguir una conexión libre, 15s para que el servidor corte una query)
# alcanzan para el tamaño de este proyecto; no hace falta setearlas.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000

# Obligatorio si NODE_ENV=production — el servidor no arranca sin esto (ver
# src/server.js). En desarrollo cae a un valor por defecto, así que acá
# puede quedar vacío.
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Genera un par propio con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tudominio.com
