PORT=3000

# Solo en 1 cuando la app corre detrás de un reverse proxy real (nginx en
# producción, ver deploy/nginx.conf.example). Deja esto vacío/en 0 en
# desarrollo local — ver el comentario junto a app.set('trust proxy', ...)
# en src/server.js para por qué importa.
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mpv_dental

JWT_SECRET=change-this-to-a-long-random-string-in-production

# Genera un par propio con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tudominio.com
